---
export const prerender = false;
import { FIRMA } from '../../data/firma';

const hatTelefon = FIRMA.telefon && !FIRMA.telefon.includes('X');
const hatEmail = FIRMA.email && !FIRMA.email.includes('autoaufbereitung-cloppenburg');
const firmenname = FIRMA.name || 'Autoaufbereitung Cloppenburg';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Treuekarte drucken – Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Inter:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #18181b;
        color: #f4f4f5;
        min-height: 100vh;
      }

      /* ── Admin nav ────────────────────────────────────────────────────── */
      .header {
        background: #09090b;
        border-bottom: 1px solid #27272a;
        padding: 0.75rem 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 0.875rem;
      }
      .header a { color: #71717a; text-decoration: none; transition: color 0.15s; }
      .header a:hover { color: #d4d4d8; }
      .header .sep { color: #3f3f46; }
      .header .title { color: #e4e4e7; font-weight: 500; }
      .header .spacer { flex: 1; }
      .header .logout { color: #52525b; font-size: 0.75rem; }
      .header .logout:hover { color: #ef4444; }

      /* ── Toolbar + Hinweis ────────────────────────────────────────────── */
      .toolbar {
        background: #27272a;
        padding: 1rem 1.5rem;
        display: flex;
        gap: 1rem;
        align-items: center;
        flex-wrap: wrap;
        border-bottom: 1px solid #3f3f46;
      }
      .toolbar button {
        background: #c9a86a;
        color: #09090b;
        border: none;
        padding: 0.65rem 1.5rem;
        font-weight: 700;
        font-family: inherit;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: background 0.15s;
        font-size: 0.875rem;
      }
      .toolbar button:hover { background: #d4b67e; }
      .toolbar p { margin: 0; color: #a1a1aa; font-size: 0.85rem; max-width: 60ch; line-height: 1.45; }

      .hinweis {
        background: rgba(201,168,106,0.08);
        border: 1px solid rgba(201,168,106,0.3);
        color: #fde68a;
        padding: 0.85rem 1.25rem;
        font-size: 0.825rem;
        line-height: 1.5;
      }
      .hinweis strong { color: #fef3c7; }

      /* ── Druckbogen ──────────────────────────────────────────────────── */
      .bogen-wrapper {
        padding: 2rem;
        display: flex;
        justify-content: center;
      }
      .bogen {
        width: 210mm;
        height: 297mm;
        background: #fafaf9; /* leichter Cream-Ton statt reinweiß */
        color: #18181b;
        display: grid;
        grid-template-columns: repeat(2, 85mm);
        grid-template-rows: repeat(5, 54mm);
        gap: 0;
        justify-content: center;
        align-content: center;
        box-shadow: 0 8px 40px rgba(0,0,0,0.5);
      }

      /* ── Eine Karte ─────────────────────────────────────────────────── */
      .karte {
        position: relative;
        width: 85mm;
        height: 54mm;
        background: #fafaf9;
        outline: 0.5pt dashed #d4d4d8; /* Schnittlinie */
        outline-offset: -0.5pt;
        padding: 4mm 5mm;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* dezentes Hintergrund-Pattern */
      .karte::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 100% 0%, rgba(201,168,106,0.06), transparent 50%),
          radial-gradient(circle at 0% 100%, rgba(15,17,19,0.04), transparent 40%);
        pointer-events: none;
      }

      /* Eckverzierungen: kleine Linien in den vier Ecken */
      .karte::after {
        content: '';
        position: absolute;
        inset: 2.5mm;
        border: 0.4pt solid rgba(15,17,19,0.18);
        border-radius: 1mm;
        pointer-events: none;
      }

      .karte-inhalt {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        height: 100%;
        gap: 2mm;
      }

      /* Header */
      .karte-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 3mm;
      }
      .karte-marke {
        flex: 1;
        min-width: 0;
      }
      .karte-eyebrow {
        font-size: 5.5pt;
        font-weight: 700;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: #a16207;
        line-height: 1;
      }
      .karte-titel {
        font-family: 'Cormorant Garamond', serif;
        font-size: 14pt;
        font-weight: 700;
        line-height: 1.05;
        color: #09090b;
        margin-top: 1.5mm;
        letter-spacing: -0.01em;
      }
      .karte-firma {
        font-size: 6.5pt;
        color: #52525b;
        margin-top: 0.7mm;
        font-weight: 500;
      }
      .karte-icon {
        width: 9mm;
        height: 9mm;
        background: #c9a86a;
        border-radius: 1.5mm;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .karte-icon svg { width: 6mm; height: 6mm; color: #09090b; }

      /* Stempel-Reihe */
      .stempel-zeile {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex: 1;
        margin: 1mm 0;
        gap: 2.5mm;
      }
      .stempel-feld {
        flex: 1;
        max-width: 11mm;
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5mm;
      }
      .stempel-kreis {
        width: 100%;
        aspect-ratio: 1;
        border: 0.6pt dashed #a1a1aa;
        border-radius: 50%;
        background: rgba(255,255,255,0.4);
      }
      .stempel-feld.belohnung .stempel-kreis {
        border: 0.8pt solid #c9a86a;
        background: #fef3c7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 6pt;
        font-weight: 700;
        color: #92400e;
        font-family: 'Inter', sans-serif;
      }
      .stempel-nummer {
        font-size: 5pt;
        color: #a1a1aa;
        font-weight: 500;
      }
      .stempel-feld.belohnung .stempel-nummer {
        color: #92400e;
        font-weight: 700;
      }

      /* Footer der Karte */
      .karte-foot {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 2mm;
        padding-top: 1mm;
        border-top: 0.3pt solid rgba(15,17,19,0.12);
      }
      .karte-belohnung {
        font-size: 5.5pt;
        color: #18181b;
        line-height: 1.35;
        max-width: 55mm;
      }
      .karte-belohnung strong { color: #a16207; font-weight: 700; }
      .karte-kontakt {
        font-size: 5.5pt;
        color: #52525b;
        text-align: right;
        line-height: 1.35;
      }

      /* ── Druck-Modus ────────────────────────────────────────────────── */
      @media print {
        body { background: white; }
        .header, .toolbar, .hinweis { display: none; }
        .bogen-wrapper { padding: 0; }
        .bogen {
          box-shadow: none;
          width: 210mm;
          height: 297mm;
        }
        .karte {
          outline: 0.3pt dashed #aaa; /* dünne Schnittlinien beim Druck */
        }
      }
      @page {
        size: A4 portrait;
        margin: 0;
      }
    </style>
  </head>

  <body>
    <div class="header">
      <a href="/admin">← Admin</a>
      <span class="sep">|</span>
      <a href="/admin/treue">← Treuekunden</a>
      <span class="sep">|</span>
      <span class="title">Treuekarte drucken</span>
      <div class="spacer"></div>
      <a href="/admin/stempel-motiv" style="color:#c9a86a">Stempel-Motiv →</a>
      <a href="/admin/logout" class="logout">Abmelden</a>
    </div>

    <div class="toolbar">
      <button type="button" onclick="window.print()">A4-Bogen drucken</button>
      <p>
        Druckt 10 Treuekarten im Visitenkartenformat (85×54&nbsp;mm) auf einer A4-Seite. Anschließend an
        den gestrichelten Linien ausschneiden. <strong style="color:#fde68a">Tipp:</strong> Auf etwas
        dickerem Papier drucken (~200&nbsp;g/m²), damit die Karte wertig wirkt.
      </p>
    </div>

    <div class="hinweis">
      <strong>Wichtig — Fälschungssicherheit:</strong> Die Stempel­felder sind absichtlich leer (kein „1, 2, 3" eingedruckt).
      Sonst könnte der Kunde mit Stift selbst nachstempeln. Du druckst ausschließlich mit deinem eigenen
      Stempel-Motiv hinein — siehe oben rechts „<a href="/admin/stempel-motiv" style="color:#c9a86a;text-decoration:underline">Stempel-Motiv</a>" zum Designen und Bestellen.
    </div>

    <div class="bogen-wrapper">
      <div class="bogen">
        {Array.from({ length: 10 }).map(() => (
          <div class="karte">
            <div class="karte-inhalt">

              <div class="karte-head">
                <div class="karte-marke">
                  <div class="karte-eyebrow">Treuekarte</div>
                  <div class="karte-titel">Jedes 5. Auto<br />— ein Goodie.</div>
                  <div class="karte-firma">{firmenname}</div>
                </div>
                <div class="karte-icon">
                  {/* Mini-Auto-Silhouette wie im Logo */}
                  <svg fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 11l1.5-4.5C6.8 5.6 7.7 5 8.6 5h6.8c.9 0 1.8.6 2.1 1.5L19 11h1c.6 0 1 .4 1 1v4c0 .6-.4 1-1 1h-1v1c0 .6-.4 1-1 1s-1-.4-1-1v-1H7v1c0 .6-.4 1-1 1s-1-.4-1-1v-1H4c-.6 0-1-.4-1-1v-4c0-.6.4-1 1-1h1zm2.1 0h9.8L15.7 7H8.3l-1.2 4zM7 13.5c0 .8-.7 1.5-1.5 1.5S4 14.3 4 13.5 4.7 12 5.5 12s1.5.7 1.5 1.5zm13 0c0 .8-.7 1.5-1.5 1.5S17 14.3 17 13.5s.7-1.5 1.5-1.5 1.5.7 1.5 1.5z" />
                  </svg>
                </div>
              </div>

              <div class="stempel-zeile">
                {[1, 2, 3, 4].map((n) => (
                  <div class="stempel-feld">
                    <div class="stempel-kreis"></div>
                    <span class="stempel-nummer">{n}</span>
                  </div>
                ))}
                <div class="stempel-feld belohnung">
                  <div class="stempel-kreis">🎁</div>
                  <span class="stempel-nummer">5</span>
                </div>
              </div>

              <div class="karte-foot">
                <div class="karte-belohnung">
                  Bei der <strong>5. Aufbereitung</strong> schenken wir Ihnen ein hochwertiges
                  Koch-Chemie-Pflegeprodukt passend zu Ihrem Auto.
                </div>
                <div class="karte-kontakt">
                  {hatTelefon && <div>{FIRMA.telefon}</div>}
                  {hatEmail && <div>{FIRMA.email}</div>}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
