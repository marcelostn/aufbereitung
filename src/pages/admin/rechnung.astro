---
export const prerender = false;
import '../../styles/global.css';
import RechnungsGenerator from '../../components/RechnungsGenerator';
import { FIRMA } from '../../data/firma';
import preiseJson from '../../data/preise.json';

const presets = [
  ...Object.values(preiseJson as Record<string, { name: string; bruttoPreis: number }>).map(p => ({
    label: p.name,
    preis: p.bruttoPreis,
  })),
  { label: 'Aufpreis: Tierhaare leicht', preis: 15 },
  { label: 'Aufpreis: Tierhaare mittel', preis: 25 },
  { label: 'Aufpreis: Tierhaare stark', preis: 45 },
  { label: 'Aufpreis: Kindersitz reinigen', preis: 20 },
  { label: 'Aufpreis: Nikotingeruch', preis: 40 },
  { label: 'Aufpreis: SUV', preis: 0 },
  { label: 'Aufpreis: Van / Bus', preis: 0 },
  { label: 'Anfahrt', preis: 0 },
];

const firmaInfo = {
  name: FIRMA.name,
  inhaber: FIRMA.inhaber,
  strasse: FIRMA.strasse,
  plz: FIRMA.plz,
  ort: FIRMA.ort,
  telefon: FIRMA.telefon,
  email: FIRMA.email,
  ustIdNr: FIRMA.ustIdNr,
  steuernummer: (FIRMA as any).steuernummer ?? '',
  iban: (FIRMA as any).iban ?? '',
  bank: (FIRMA as any).bank ?? '',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rechnungs-Generator – Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: 'Inter', system-ui, sans-serif; }

      @media print {
        .no-print { display: none !important; }
        body { background: white !important; margin: 0; }
        main { padding: 0 !important; }
        #rechnung-dokument {
          box-shadow: none !important;
          border-radius: 0 !important;
          max-width: none !important;
          padding: 2cm 2.5cm !important;
        }
      }

      @page {
        size: A4;
        margin: 0;
      }
    </style>
  </head>

  <body class="bg-zinc-950 text-zinc-100 min-h-screen">
    <!-- Admin nav bar -->
    <div class="no-print border-b border-zinc-800 bg-zinc-900/70 px-5 py-3 flex items-center gap-3 text-sm">
      <a href="/admin" class="text-zinc-500 hover:text-zinc-300 transition-colors">
        ← Admin
      </a>
      <span class="text-zinc-700">|</span>
      <span class="text-zinc-300 font-medium">Rechnungs-Generator</span>
      <a href="/admin/logout" class="ml-auto text-zinc-600 hover:text-red-400 text-xs transition-colors">
        Abmelden
      </a>
    </div>

    <main class="p-5 sm:p-8">
      <RechnungsGenerator client:load firma={firmaInfo} presets={presets} />
    </main>
  </body>
</html>
