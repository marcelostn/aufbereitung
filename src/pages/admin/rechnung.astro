---
export const prerender = false;
import '../../styles/global.css';
import RechnungsGenerator from '../../components/RechnungsGenerator';
import { FIRMA } from '../../data/firma';
import preiseJson from '../../data/preise.json';
import lkwJson from '../../data/lkw.json';

// Detaillierte Leistungsbeschreibungen (für §14 UStG: "Menge / Umfang der Leistung")
const pkwBeschreibungen: Record<string, string> = {
  'Außenreinigung':                  'Fahrzeugaufbereitung PKW – Außen: Felgenreinigung, Schaumbad-Vorwäsche, Handwäsche mit Zwei-Eimer-Methode, Türrahmen + Dichtungen, streifenfreies Trocknen, Reifenpflege (ca. 1,5 Std.)',
  'Innen Basic':                     'Innenraumreinigung PKW Basic: Aussaugen Sitze + Boden + Kofferraum, Armaturen feucht abwischen, Türverkleidungen oberflächlich, Scheiben innen, Fußmatten reinigen (ca. 1,5 Std.)',
  'Innen Premium':                   'Innenraumreinigung PKW Premium: Vollständige Innenreinigung inkl. Sitzpolster shampoonieren, Türverkleidungen tief, Kofferraum, Lederpflege, Lüftungslamellen, Geruchsneutralisierung (ca. 2,5 Std.)',
  'Innen Full Detail':               'Innenraumreinigung PKW Full Detail: Dampfreinigung Polster + Lüftungen + Spalten, Sprühextraktion Teppiche, Sicherheitsgurte einzeln, Himmelreinigung, gezielte Geruchsneutralisierung (ca. 4 Std.)',
  'Komplett Basic (Innen + Außen)':  'Komplettaufbereitung PKW Basic: Außenreinigung von Hand + Innenreinigung Basic (Aussaugen, Armaturen, Scheiben innen). 30 % Bündelrabatt enthalten (ca. 3 Std.)',
  'Komplett Premium':                'Komplettaufbereitung PKW Premium: Außenreinigung + Innenreinigung Premium mit Polsterbehandlung und Lederpflege. 30 % Bündelrabatt enthalten (ca. 4 Std.)',
  'Komplett Full Detail':            'Komplettaufbereitung PKW Full Detail: Außenreinigung + Innenreinigung Full Detail mit Dampfreinigung, Sprühextraktion und Geruchsneutralisierung. 30 % Bündelrabatt enthalten (ca. 5,5 Std.)',
};

const lkwBeschreibungen: Record<string, string> = {
  'LKW Kabine Basic':          'Fahrzeugaufbereitung Nutzfahrzeug LKW – Kabine Basic: Aussaugen Fahrerkabine, Armaturen wischen, Scheiben innen (ca. 1,5 Std.)',
  'LKW Kabine Premium':        'Fahrzeugaufbereitung Nutzfahrzeug LKW – Kabine Premium: Innenreinigung Fahrerkabine, Polster-/Teppichreinigung, Armaturenpflege, Scheibenreinigung innen (ca. 3 Std.)',
  'LKW Kabine Full Detail':    'Fahrzeugaufbereitung Nutzfahrzeug LKW – Kabine Full Detail: Komplette Innenreinigung Kabine inkl. Dampfreinigung, Sprühextraktion und Geruchsneutralisierung (ca. 4,5 Std.)',
  'Traktor Kabine Basic':      'Fahrzeugaufbereitung Nutzfahrzeug Traktor – Kabine Basic: Aussaugen Fahrerkabine, Armaturen wischen, Scheiben innen (ca. 1,5 Std.)',
  'Traktor Kabine Premium':    'Fahrzeugaufbereitung Nutzfahrzeug Traktor – Kabine Premium: Innenreinigung Kabine, Polster-/Teppichreinigung, Armaturenpflege (ca. 3 Std.)',
  'Transporter Innen Basic':   'Fahrzeugaufbereitung Nutzfahrzeug Transporter – Innen Basic: Aussaugen, Armaturen wischen, Scheiben innen, Laderaum kehren (ca. 2 Std.)',
  'Transporter Innen Premium': 'Fahrzeugaufbereitung Nutzfahrzeug Transporter – Innen Premium: Komplette Innenreinigung Fahrerhaus + Laderaum, Polsterbehandlung (ca. 3,5 Std.)',
};

const pkwPakete = Object.values(preiseJson as Record<string, { name: string; bruttoPreis: number }>).map(p => ({
  label: `PKW: ${p.name}`,
  preis: p.bruttoPreis,
  beschreibung: pkwBeschreibungen[p.name] ?? p.name,
}));

const lkwPakete = (lkwJson.pakete as Array<{ name: string; bruttoPreis: number }>).map(p => ({
  label: `Nutzfahrzeug: ${p.name}`,
  preis: p.bruttoPreis,
  beschreibung: lkwBeschreibungen[p.name] ?? p.name,
}));

const presets = [
  ...pkwPakete,
  ...lkwPakete,
  // ── Aufpreise (auf Paket) ──
  { label: 'Aufpreis: Tierhaare leicht',                          preis: 15 },
  { label: 'Aufpreis: Tierhaare mittel',                          preis: 25 },
  { label: 'Aufpreis: Tierhaare stark',                           preis: 45 },
  { label: 'Aufpreis: Kindersitz reinigen',                       preis: 20 },
  { label: 'Aufpreis: Nikotingeruch',                             preis: 40 },
  { label: 'Aufpreis: SUV (+15 % auf Paket)',                     preis: 0, prozent: 0.15 },
  { label: 'Aufpreis: Van / Bus (+30 % auf Paket)',               preis: 0, prozent: 0.30 },
  { label: 'Aufpreis: Lang / 7-Sitzer (+20 % auf Paket)',         preis: 0, prozent: 0.20 },
  { label: 'Aufpreis Nutzfahrzeug: Wochenend-Zuschlag (+20 %)',   preis: 0, prozent: 0.20 },
  { label: 'Aufpreis Nutzfahrzeug: Express < 48 h (+15 %)',       preis: 0, prozent: 0.15 },
  // ── Rabatte (auf Gesamtsumme) ──
  { label: 'Rabatt: Neukunden-Rabatt (−10 % auf alles)',          preis: 0, prozent: -0.10, vonGesamt: true },
  { label: 'Rabatt: Familie / Freunde (−25 % auf alles)',         preis: 0, prozent: -0.25, vonGesamt: true },
  { label: 'Rabatt Nutzfahrzeug: ab 3 Fahrzeuge (−10 % auf alles)', preis: 0, prozent: -0.10, vonGesamt: true },
  // ── Sonstiges ──
  { label: 'Anfahrt',                                             preis: 0 },
  { label: 'Sonstiges (frei eingeben)',                           preis: 0 },
];

const firmaInfo = {
  name: FIRMA.name,
  inhaber: FIRMA.inhaber,
  strasse: FIRMA.strasse,
  plz: FIRMA.plz,
  ort: FIRMA.ort,
  telefon: FIRMA.telefon,
  email: FIRMA.email,
  ustIdNr: FIRMA.ustIdNr,
  steuernummer: (FIRMA as any).steuernummer ?? '',
  iban: (FIRMA as any).iban ?? '',
  bank: (FIRMA as any).bank ?? '',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rechnungs-Generator – Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap"
      rel="stylesheet"
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body { font-family: 'Inter', system-ui, sans-serif; }

      @media print {
        .no-print { display: none !important; }
        body { background: white !important; margin: 0; }
        main { padding: 0 !important; }
        #rechnung-dokument {
          box-shadow: none !important;
          border-radius: 0 !important;
          max-width: none !important;
          padding: 2cm 2.5cm !important;
        }
      }

      @page {
        size: A4;
        margin: 0;
      }
    </style>
  </head>

  <body class="bg-zinc-950 text-zinc-100 min-h-screen">
    <!-- Admin nav bar -->
    <div class="no-print border-b border-zinc-800 bg-zinc-900/70 px-5 py-3 flex items-center gap-3 text-sm">
      <a href="/admin" class="text-zinc-500 hover:text-zinc-300 transition-colors">
        ← Admin
      </a>
      <span class="text-zinc-700">|</span>
      <span class="text-zinc-300 font-medium">Rechnungs-Generator</span>
      <a href="/admin/logout" class="ml-auto text-zinc-600 hover:text-red-400 text-xs transition-colors">
        Abmelden
      </a>
    </div>

    <main class="p-5 sm:p-8">
      <RechnungsGenerator client:load firma={firmaInfo} presets={presets} />
    </main>
  </body>
</html>
