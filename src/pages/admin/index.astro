---
export const prerender = false;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin – Glanzwerk Cloppenburg</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #0f1113;
        color: #f2f3f5;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        gap: 2rem;
      }
      .header { text-align: center; }
      .header h1 { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.03em; }
      .header p  { font-size: 0.85rem; color: #71717a; margin-top: 0.3rem; }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        width: 100%;
        max-width: 460px;
      }
      .card:last-child:nth-child(odd) {
        grid-column: span 2;
      }
      .card {
        background: #1e2125;
        border: 1px solid #2c3036;
        border-radius: 1rem;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: border-color 0.15s, background 0.15s;
        cursor: pointer;
      }
      .card:hover { border-color: #c9a86a; background: #252a2f; }
      .icon {
        width: 40px; height: 40px;
        border-radius: 0.6rem;
        display: flex; align-items: center; justify-content: center;
      }
      .icon-gold { background: rgba(201,168,106,0.15); }
      .icon-chrome { background: rgba(199,204,211,0.1); }
      .icon svg { width: 20px; height: 20px; }
      .card-title { font-size: 0.95rem; font-weight: 700; }
      .card-desc  { font-size: 0.78rem; color: #71717a; line-height: 1.5; }
      .logout {
        font-size: 0.8rem;
        color: #52525b;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        transition: color 0.15s;
      }
      .logout:hover { color: #ef4444; }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Admin-Bereich</h1>
      <p>Glanzwerk Cloppenburg</p>
    </div>

    <div class="grid">
      <!-- Termine -->
      <a href="/admin/termine" class="card">
        <div class="icon icon-gold">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c9a86a" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5m-9-6h.008v.008H12v-.008Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Termine</div>
          <div class="card-desc">Buchungsanfragen bestätigen, ändern und abschließen</div>
        </div>
      </a>

      <!-- Verfügbarkeit -->
      <a href="/admin/verfuegbarkeit" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Verfügbarkeit</div>
          <div class="card-desc">Arbeitszeiten, Kapazität und Puffer für die Buchung</div>
        </div>
      </a>

      <!-- CMS -->
      <a href="/keystatic" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
          </svg>
        </div>
        <div>
          <div class="card-title">Inhalte & Preise</div>
          <div class="card-desc">Firmendaten, Pakete und Aufpreise bearbeiten</div>
        </div>
      </a>

      <!-- Rechnung -->
      <a href="/admin/rechnung" class="card">
        <div class="icon icon-gold">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c9a86a" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Rechnungen</div>
          <div class="card-desc">Neue Rechnung erstellen oder Archiv durchsuchen</div>
        </div>
      </a>

      <!-- Lager -->
      <a href="/admin/lager" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="m20.25 7.5-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Lager & Bestand</div>
          <div class="card-desc">Verbrauchsmittel, Geräteabschreibung und Kosten im Blick</div>
        </div>
      </a>

      <!-- Treue -->
      <a href="/admin/treue" class="card">
        <div class="icon icon-gold">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c9a86a" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.32.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .32-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Treuekunden</div>
          <div class="card-desc">Stempelkarten, Stempel-Motiv und Belohnungen</div>
        </div>
      </a>

      <!-- Newsletter -->
      <a href="/admin/newsletter" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        </div>
        <div>
          <div class="card-title">Newsletter</div>
          <div class="card-desc">Subscriber verwalten und für Brevo exportieren</div>
        </div>
      </a>

      <!-- Datenbank-Setup -->
      <a href="/admin/datenbank" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
          </svg>
        </div>
        <div>
          <div class="card-title">Datenbank</div>
          <div class="card-desc">Geräte-Sync via Supabase einrichten — für Handy + PC</div>
        </div>
      </a>
    </div>

    <a href="/admin/logout" class="logout">Abmelden</a>
  </body>
</html>
