---
export const prerender = false;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin – AutoAufbereitung</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', system-ui, sans-serif;
        background: #0f1113;
        color: #f2f3f5;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        gap: 2rem;
      }
      .header { text-align: center; }
      .header h1 { font-size: 1.4rem; font-weight: 900; letter-spacing: -0.03em; }
      .header p  { font-size: 0.85rem; color: #71717a; margin-top: 0.3rem; }
      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        width: 100%;
        max-width: 460px;
      }
      .card {
        background: #1e2125;
        border: 1px solid #2c3036;
        border-radius: 1rem;
        padding: 1.5rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        transition: border-color 0.15s, background 0.15s;
        cursor: pointer;
      }
      .card:hover { border-color: #c9a86a; background: #252a2f; }
      .icon {
        width: 40px; height: 40px;
        border-radius: 0.6rem;
        display: flex; align-items: center; justify-content: center;
      }
      .icon-gold { background: rgba(201,168,106,0.15); }
      .icon-chrome { background: rgba(199,204,211,0.1); }
      .icon svg { width: 20px; height: 20px; }
      .card-title { font-size: 0.95rem; font-weight: 700; }
      .card-desc  { font-size: 0.78rem; color: #71717a; line-height: 1.5; }
      .logout {
        font-size: 0.8rem;
        color: #52525b;
        text-decoration: none;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        transition: color 0.15s;
      }
      .logout:hover { color: #ef4444; }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Admin-Bereich</h1>
      <p>AutoAufbereitung Cloppenburg</p>
    </div>

    <div class="grid">
      <!-- CMS -->
      <a href="/keystatic" class="card">
        <div class="icon icon-chrome">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c7ccd3" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75" />
          </svg>
        </div>
        <div>
          <div class="card-title">Inhalte & Preise</div>
          <div class="card-desc">Firmendaten, Pakete und Aufpreise bearbeiten</div>
        </div>
      </a>

      <!-- Rechnung -->
      <a href="/admin/rechnung" class="card">
        <div class="icon icon-gold">
          <svg fill="none" viewBox="0 0 24 24" stroke="#c9a86a" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <div>
          <div class="card-title">Rechnung schreiben</div>
          <div class="card-desc">Rechnung für abgeschlossene Aufträge erstellen</div>
        </div>
      </a>
    </div>

    <a href="/admin/logout" class="logout">Abmelden</a>
  </body>
</html>
