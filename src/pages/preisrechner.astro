---
import BaseLayout from '../layouts/BaseLayout.astro';
import PriceCalculator from '../components/PriceCalculator';
import { FIRMA, CAL_LINKS } from '../data/firma';
---

<BaseLayout
  title="Preis & Termin"
  description="Preis berechnen und direkt einen Termin buchen – für PKW, SUV, Van, LKW und Traktor in Cloppenburg."
>
  <section class="relative bg-gradient-to-br from-zinc-950 via-zinc-900 to-zinc-800 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 70% 50% at 50% 0%, rgba(245,158,11,0.07), transparent)"></div>
    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 py-16 sm:py-20 text-center">
      <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 text-amber-400 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V13.5Zm0 2.25h.008v.008H8.25v-.008Zm0 2.25h.008v.008H8.25V18Zm2.498-6.75h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V13.5Zm0 2.25h.007v.008h-.007v-.008Zm0 2.25h.007v.008h-.007V18Zm2.504-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5Zm0 2.25h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V18Zm2.498-6.75h.008v.008h-.008v-.008Zm0 2.25h.008v.008h-.008V13.5ZM8.25 6h7.5v2.25h-7.5V6ZM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.616 4.5 4.698V18a2.25 2.25 0 0 0 2.25 2.25h10.5A2.25 2.25 0 0 0 19.5 18V4.698c0-1.082-.807-1.998-1.907-2.126A48.234 48.234 0 0 0 12 2.25Z" />
        </svg>
        Preis berechnen & Termin buchen
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tighter mb-4">
        Preis berechnen &amp; <span class="text-amber-400">Termin buchen</span>
      </h1>
      <p class="text-lg text-zinc-300 max-w-xl mx-auto leading-relaxed">
        Fahrzeug und Leistung wählen, Preis sofort sehen —
        und danach direkt einen Termin anfragen.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <PriceCalculator client:load calLink={FIRMA.calLink ?? ''} calLinks={CAL_LINKS} telefon={FIRMA.telefon} />
  </section>

  <div class="pb-16 text-center">
    <p class="text-xs text-zinc-600">Alle Preise inkl. 19 % MwSt. · Festpreise · Aufpreise ggf. vor Ort nach Prüfung.</p>
  </div>
</BaseLayout>
