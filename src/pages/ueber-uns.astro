---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FIRMA } from '../data/firma';
import Galerie from '../components/Galerie.astro';
---

<BaseLayout
  title="Über uns"
  description={`Erfahren Sie mehr über ${FIRMA.name} – mobiler Autoaufbereitungs-Service aus ${FIRMA.ort}.`}
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
    <div class="fade-in-up">
      <p class="text-amber-400 text-sm font-semibold uppercase tracking-widest mb-3">Über uns</p>
      <h1 class="text-3xl sm:text-4xl font-black tracking-tighter text-zinc-100 mb-6">
        Mobiler Aufbereitungs-Service<br />
        <span class="text-amber-400">aus {FIRMA.ort}</span>
      </h1>
    </div>

    <div class="space-y-5 text-zinc-300 leading-relaxed fade-in-up delay-1">
      <p>
        Wir sind ein mobiler Autoaufbereitungs-Service aus <strong class="text-zinc-100">{FIRMA.ort}</strong> und arbeiten leidenschaftlich daran,
        Ihr Fahrzeug wieder in einen top Zustand zu bringen – direkt bei Ihnen vor der Tür.
      </p>

      <p class="text-zinc-500 italic text-sm border-l-2 border-amber-500/40 pl-4">
        {/* TODO: Persönliche Geschichte hier eintragen – mit Geschäftspartner besprechen */}
        Als [Beruf eintragen] haben wir unsere Leidenschaft für saubere Fahrzeuge schon früh entdeckt.
        Mit professionellen Produkten und der nötigen Sorgfalt behandeln wir jedes Fahrzeug so, als wäre es unser eigenes.
      </p>
    </div>

    <!-- Versprechen-Liste -->
    <div class="mt-10 fade-in-up delay-2">
      <h2 class="text-xl font-black tracking-tight text-zinc-100 mb-5">Unser Versprechen</h2>
      <ul class="space-y-3">
        {[
          'Persönlicher Service direkt bei Ihnen',
          'Transparente Festpreise ohne Überraschungen',
          'Betriebshaftpflicht – Ihr Fahrzeug ist bei uns versichert',
          'Professionelle Produkte und Geräte',
          `Einzugsgebiet: ${FIRMA.einzugsgebiet}`,
        ].map((punkt) => (
          <li class="flex items-start gap-3 text-zinc-300">
            <span class="mt-0.5 w-5 h-5 rounded-full bg-amber-500/10 border border-amber-500/30 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-amber-400" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
              </svg>
            </span>
            {punkt}
          </li>
        ))}
      </ul>
    </div>

    <!-- Einzugsgebiet -->
    <div class="mt-10 bg-zinc-900/60 backdrop-blur-sm border border-zinc-800/60 rounded-2xl p-6 fade-in-up delay-3">
      <h2 class="text-lg font-bold text-zinc-100 mb-2">Einzugsgebiet</h2>
      <p class="text-zinc-400 text-sm leading-relaxed">
        Wir kommen zu Ihnen in {FIRMA.ort} und Umgebung. Im Umkreis von <strong class="text-zinc-200">10 km ist die Anfahrt kostenlos</strong>.
        Über diesen Radius hinaus berechnen wir lediglich eine kleine Kilometergebühr – transparent und fair.
      </p>
    </div>

    <!-- CTAs -->
    <div class="mt-10 flex flex-col sm:flex-row gap-3 fade-in-up delay-3">
      <a
        href="/kontakt"
        class="btn-gold px-8 py-3.5 rounded-xl font-bold text-center min-h-[52px] flex items-center justify-center"
      >
        Kontakt aufnehmen
      </a>
      <a
        href="/preisrechner"
        class="border border-zinc-700 hover:border-amber-500/50 hover:bg-amber-500/5 text-zinc-200 transition-all duration-200 px-8 py-3.5 rounded-xl font-bold text-center min-h-[52px] flex items-center justify-center"
      >
        Preisrechner starten
      </a>
    </div>
  </div>

  <!-- Galerie – echte Auftragsfotos -->
  <Galerie titel="Ergebnisse, die für sich sprechen" />
</BaseLayout>
