---
// Scroll-gekoppelte Video-Reveal-Sektion ("scrollytelling"), Vollbild.
// Kein abspielendes Video: die Scroll-Position steuert das Frame.
// Text liegt über dem Clip und blendet scroll-synchron ein/aus.
// Cineastische Farbkorrektur (Vignette + Grade) liegt über dem Video.
// Quelle: /animations/scroll-reveal.mp4 (all-keyframe, exaktes Seeking).
// Bei prefers-reduced-motion / Sparmodus: statisches Standbild + Text.
---

<section class="sr-wrap" id="scroll-reveal" aria-label="Vom ersten Blick bis zum letzten Detail">
  <div class="sr-sticky">
    <video
      class="sr-video"
      muted
      playsinline
      preload="auto"
      tabindex="-1"
      aria-hidden="true"
      poster="/animations/scroll-reveal-poster.jpg"
    >
      <source src="/animations/scroll-reveal.mp4" type="video/mp4" />
    </video>

    <!-- Cineastischer Grade: Vignette + warmer Look + Kanten-Blend -->
    <div class="sr-grade" aria-hidden="true"></div>

    <!-- Intro-Text: sichtbar beim Reinscrollen, blendet dann aus -->
    <div class="sr-intro">
      <p class="sr-kicker">Detailing in Perfektion</p>
      <h2 class="chrome-sweep">Vom ersten Blick<br />bis zum letzten Detail.</h2>
      <p class="sr-sub">Scrollen Sie weiter.</p>
    </div>

    <!-- Outro: blendet zum Ende des Clips ein -->
    <div class="sr-outro">
      <h2 class="chrome-sweep">Jedes Detail. Perfekt.</h2>
    </div>

    <div class="sr-hint" aria-hidden="true">
      <span>Scrollen</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25 12 15.75 4.5 8.25" />
      </svg>
    </div>
  </div>
</section>

<style>
  .sr-wrap {
    position: relative;
    /* Scroll-Strecke: je höher, desto langsamer/edler scrubbt das Video */
    height: 340vh;
    /* Farbverlauf passend zu den angrenzenden Sektionen:
       oben → zinc-950 (#09090b), unten → zinc-900 (#18181b) */
    background: #09090b;
    --intro: 1;
    --outro: 0;
  }
  .sr-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .sr-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .sr-wrap.sr-ready .sr-video { opacity: 1; }

  /* Cineastische Farbkorrektur (mehrere Layer, oberster zuerst):
     1) Vignette  2) warmer Grade  3) oben → zinc-950  4) unten → zinc-900 */
  .sr-grade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background:
      /* Vignette: dunkle Kanten, freies Zentrum */
      radial-gradient(ellipse 75% 70% at 50% 45%, transparent 28%, rgba(6,7,9,0.22) 60%, rgba(6,7,9,0.52) 100%),
      /* Warmer cineastischer Tint */
      linear-gradient(180deg, rgba(58,40,18,0.09) 0%, transparent 50%, rgba(20,16,30,0.07) 100%),
      /* Oben: sanft in zinc-950 (#09090b) ausblenden – sehr breites Band */
      linear-gradient(180deg,
        #09090b 0%,
        rgba(9,9,11,0.95) 4%,
        rgba(9,9,11,0.80) 10%,
        rgba(9,9,11,0.55) 18%,
        rgba(9,9,11,0.28) 28%,
        rgba(9,9,11,0.08) 40%,
        transparent 52%),
      /* Unten: sanft in zinc-950 (#09090b) ausblenden – sehr breites Band */
      linear-gradient(0deg,
        #09090b 0%,
        rgba(9,9,11,0.95) 4%,
        rgba(9,9,11,0.80) 10%,
        rgba(9,9,11,0.55) 18%,
        rgba(9,9,11,0.28) 28%,
        rgba(9,9,11,0.08) 40%,
        transparent 52%);
  }

  /* ---- Text-Overlays ---- */
  .sr-intro,
  .sr-outro {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1.1rem;
    padding: 1.5rem;
    color: #f5f6f7;
    text-shadow: 0 2px 24px rgba(0,0,0,0.55);
  }
  .sr-intro {
    opacity: var(--intro);
    transform: translateY(calc((1 - var(--intro)) * -28px));
    transition: opacity 0.12s linear;
  }
  .sr-outro {
    opacity: var(--outro);
    transform: translateY(calc((1 - var(--outro)) * 28px));
    transition: opacity 0.12s linear;
    pointer-events: none;
  }
  .sr-wrap.sr-end .sr-outro { pointer-events: auto; }

  .sr-kicker {
    text-transform: uppercase;
    letter-spacing: 0.24em;
    font-size: 0.8rem;
    font-weight: 600;
    color: #d3d7dc;
  }
  .sr-intro h2,
  .sr-outro h2 {
    font-size: clamp(2.4rem, 6.5vw, 5rem);
    line-height: 1.04;
    max-width: 16ch;
  }
  .sr-sub {
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
    color: #c7ccd3;
    letter-spacing: 0.04em;
  }
  .sr-hint {
    position: absolute;
    z-index: 3;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    color: #9aa0a8;
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition: opacity 0.4s ease;
  }
  .sr-hint svg {
    width: 1.1rem;
    height: 1.1rem;
    animation: sr-bounce 1.8s ease-in-out infinite;
  }
  .sr-wrap.sr-scrolled .sr-hint { opacity: 0; }
  @keyframes sr-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ---- Fallback: keine Bewegung / Sparmodus -> Standbild ---- */
  .sr-wrap.sr-static { height: auto; }
  .sr-wrap.sr-static .sr-sticky {
    position: relative;
    height: clamp(440px, 72vh, 720px);
  }
  .sr-wrap.sr-static .sr-video { display: none; }
  .sr-wrap.sr-static .sr-hint { display: none; }
  .sr-wrap.sr-static {
    background: #09090b url('/animations/scroll-reveal-poster.jpg') center/cover no-repeat;
  }
  .sr-wrap.sr-static .sr-intro { opacity: 0; }
  .sr-wrap.sr-static .sr-outro { opacity: 1; pointer-events: auto; }
  @media (prefers-reduced-motion: reduce) {
    .sr-hint svg { animation: none; }
  }
</style>

<script>
  const wrapEl = document.getElementById('scroll-reveal');
  if (wrapEl) {
    const wrap: HTMLElement = wrapEl;
    const v = wrap.querySelector('.sr-video') as HTMLVideoElement;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData =
      window.matchMedia('(prefers-reduced-data: reduce)').matches ||
      // @ts-ignore - nicht in allen TS-libdoms
      (navigator.connection && navigator.connection.saveData === true);

    if (reduceMotion || saveData || !v) {
      wrap.classList.add('sr-static', 'sr-ready');
    } else {
      let target = 0;
      let current = 0;
      let raf = 0;

      const dur = () =>
        v.duration && isFinite(v.duration) && v.duration > 0 ? v.duration : 8;
      const markReady = () => wrap.classList.add('sr-ready');

      // WICHTIG: Zustand SOFORT prüfen – Script läuft deferred,
      // das Video kann bereits geladen sein (Events verpasst).
      if (v.readyState >= 2) markReady();
      v.addEventListener('loadeddata', () => { markReady(); onScroll(); }, { once: true });
      v.addEventListener('canplay', () => { markReady(); onScroll(); }, { once: true });
      v.addEventListener('loadedmetadata', onScroll, { once: true });

      // Decoder anstoßen (iOS/Safari rendert sonst kein Seek-Frame)
      const kick = () => {
        const p = v.play();
        if (p && typeof p.then === 'function') p.then(() => v.pause()).catch(() => {});
      };
      kick();
      window.addEventListener('touchstart', kick, { once: true, passive: true });

      // weiches Ein-/Ausblenden (smoothstep) für Text-Overlays
      const smooth = (a: number, b: number, x: number) => {
        const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
        return t * t * (3 - 2 * t);
      };

      function computeProgress() {
        const total = wrap.offsetHeight - window.innerHeight;
        if (total <= 0) return 0;
        const top = wrap.getBoundingClientRect().top;
        return Math.min(1, Math.max(0, -top / total));
      }

      function tick() {
        raf = 0;
        current += (target - current) * 0.15; // weiches Nachziehen
        if (Math.abs(target - current) < 0.0008) current = target;

        const t = current * Math.max(0, dur() - 0.05);
        if (!v.seeking && Math.abs(v.currentTime - t) > 0.01) {
          try {
            if (typeof v.fastSeek === 'function') v.fastSeek(t);
            else v.currentTime = t;
          } catch (e) { /* seek noch nicht möglich */ }
        }

        // Intro sichtbar 0–8 %, blendet bis 28 % aus
        const intro = 1 - smooth(0.08, 0.28, current);
        // Outro blendet ab 70 % ein, voll ab 90 %
        const outro = smooth(0.70, 0.90, current);
        wrap.style.setProperty('--intro', String(intro));
        wrap.style.setProperty('--outro', String(outro));
        wrap.classList.toggle('sr-end', current > 0.78);

        if (Math.abs(target - current) > 0.0008) {
          raf = requestAnimationFrame(tick);
        }
      }

      function onScroll() {
        target = computeProgress();
        if (target > 0.01) wrap.classList.add('sr-scrolled');
        else wrap.classList.remove('sr-scrolled');
        if (!raf) raf = requestAnimationFrame(tick);
      }

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      onScroll();
    }
  }
</script>
