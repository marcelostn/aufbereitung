---
import { FIRMA } from '../data/firma';

const navLinks = [
  { href: '/', label: 'Start' },
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/preisrechner', label: 'Preis & Termin' },
  { href: '/ueber-uns', label: 'Über uns' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-zinc-950 border-b border-zinc-800 text-zinc-100 shadow-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" aria-label={FIRMA.name} class="flex items-center shrink-0 hover:opacity-80 transition-opacity duration-200 cursor-pointer">

      <!-- Volllogo mit Linien-Auto + Wordmark (ab sm) -->
      <svg class="hidden sm:block h-10 w-auto" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 210 52" fill="none" aria-hidden="true">
        <!-- Karosserie-Oberkante -->
        <path d="M 4 27 L 15 11 L 37 11 L 43 18 Q 47 23 47 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- Heckstoßstange -->
        <line x1="4" y1="27" x2="4" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <!-- Unterboden Heck -->
        <line x1="4" y1="31" x2="7" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <!-- Hinterer Radkasten -->
        <path d="M 7 31 Q 14 40 21 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <!-- Unterboden Mitte -->
        <line x1="21" y1="31" x2="33" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <!-- Vorderer Radkasten -->
        <path d="M 33 31 Q 40 40 47 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <!-- Räder -->
        <circle cx="14" cy="40" r="6.5" stroke="#c7ccd3" stroke-width="2"/>
        <circle cx="14" cy="40" r="2.2" fill="#c7ccd3"/>
        <circle cx="40" cy="40" r="6.5" stroke="#c7ccd3" stroke-width="2"/>
        <circle cx="40" cy="40" r="2.2" fill="#c7ccd3"/>
        <!-- Fenster -->
        <path d="M 17 11 L 15 23 L 35 23 L 37 11" stroke="#c7ccd3" stroke-width="1.5" fill="none" stroke-linejoin="round" opacity="0.7"/>
        <!-- B-Säule -->
        <line x1="27" y1="11" x2="26.5" y2="23" stroke="#c7ccd3" stroke-width="1.4" stroke-linecap="round" opacity="0.55"/>
        <!-- Türlinie -->
        <line x1="26.5" y1="23" x2="26" y2="31" stroke="#c7ccd3" stroke-width="1.1" stroke-linecap="round" opacity="0.35"/>
        <!-- Scheinwerfer -->
        <line x1="46" y1="22" x2="49" y2="25" stroke="#fef08a" stroke-width="2.5" stroke-linecap="round"/>
        <!-- Rücklicht -->
        <line x1="3" y1="28" x2="3" y2="31" stroke="#fca5a5" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
        <!-- Wordmark -->
        <text x="62" y="30" font-family="Inter, 'Arial Narrow', Arial, sans-serif" font-weight="900" font-size="22" letter-spacing="-0.5">
          <tspan fill="white">Auto</tspan><tspan fill="#e8ebee">Care</tspan>
        </text>
        <line x1="62" y1="35" x2="186" y2="35" stroke="#c7ccd3" stroke-width="0.7" opacity="0.25"/>
        <text x="63" y="46" font-family="Inter, Arial, sans-serif" font-weight="500" font-size="9.5" fill="#8b9098" letter-spacing="2.5">CLOPPENBURG</text>
      </svg>

      <!-- Icon only – Linien-Auto (mobil) -->
      <svg class="block sm:hidden h-10 w-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" fill="none" aria-hidden="true">
        <path d="M 4 27 L 15 11 L 37 11 L 43 18 Q 47 23 47 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        <line x1="4" y1="27" x2="4" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <line x1="4" y1="31" x2="7" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M 7 31 Q 14 40 21 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <line x1="21" y1="31" x2="33" y2="31" stroke="#c7ccd3" stroke-width="2.2" stroke-linecap="round"/>
        <path d="M 33 31 Q 40 40 47 31" stroke="#c7ccd3" stroke-width="2.2" fill="none" stroke-linecap="round"/>
        <circle cx="14" cy="40" r="6.5" stroke="#c7ccd3" stroke-width="2"/>
        <circle cx="14" cy="40" r="2.2" fill="#c7ccd3"/>
        <circle cx="40" cy="40" r="6.5" stroke="#c7ccd3" stroke-width="2"/>
        <circle cx="40" cy="40" r="2.2" fill="#c7ccd3"/>
        <path d="M 17 11 L 15 23 L 35 23 L 37 11" stroke="#c7ccd3" stroke-width="1.5" fill="none" stroke-linejoin="round" opacity="0.7"/>
        <line x1="27" y1="11" x2="26.5" y2="23" stroke="#c7ccd3" stroke-width="1.4" stroke-linecap="round" opacity="0.55"/>
        <line x1="46" y1="22" x2="49" y2="25" stroke="#fef08a" stroke-width="2.5" stroke-linecap="round"/>
        <line x1="3" y1="28" x2="3" y2="31" stroke="#fca5a5" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
        <path d="M 21 13 L 19 24 L 33 24 L 31 13 Z" fill="#9aa0a8" opacity="0.85"/>
        <rect x="25.3" y="13" width="1.7" height="11" fill="#c7ccd3"/>
        <ellipse cx="46" cy="30" rx="3.2" ry="2.5" fill="#fef9c3"/>
        <ellipse cx="6" cy="30" rx="2.5" ry="2" fill="#fecaca"/>
        <circle cx="14" cy="39" r="7" fill="#451a03"/>
        <circle cx="14" cy="39" r="2.8" fill="#c7ccd3"/>
        <circle cx="38" cy="39" r="7" fill="#451a03"/>
        <circle cx="38" cy="39" r="2.8" fill="#c7ccd3"/>
        <path d="M 42 4 L 43.1 7.9 L 47 9 L 43.1 10.1 L 42 14 L 40.9 10.1 L 37 9 L 40.9 7.9 Z" fill="white"/>
        <path d="M 48 18 L 48.6 19.4 L 51 20 L 48.6 20.6 L 48 22 L 47.4 20.6 L 45 20 L 47.4 19.4 Z" fill="white" opacity="0.75"/>
      </svg>
    </a>

    <!-- Desktop-Nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class={`px-3 py-2 rounded-lg transition-colors duration-200 cursor-pointer ${
            currentPath === href
              ? 'bg-amber-500 text-zinc-900'
              : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800'
          }`}
        >
          {label}
        </a>
      ))}
      <a
        href="/kontakt"
        class="btn-gold ml-3 px-4 py-2 rounded-lg font-semibold cursor-pointer min-h-[40px] flex items-center"
      >
        Jetzt anfragen
      </a>
    </nav>

    <!-- Mobile Burger -->
    <button
      id="burger-btn"
      aria-label="Menü öffnen"
      aria-expanded="false"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-zinc-800 transition-colors duration-200 cursor-pointer min-w-[44px] min-h-[44px] items-center justify-center"
    >
      <span class="block w-5 h-0.5 bg-zinc-300 transition-all duration-200" id="burger-line-1"></span>
      <span class="block w-5 h-0.5 bg-zinc-300 transition-all duration-200" id="burger-line-2"></span>
      <span class="block w-5 h-0.5 bg-zinc-300 transition-all duration-200" id="burger-line-3"></span>
    </button>
  </div>

  <!-- Mobile Nav Dropdown -->
  <nav
    id="mobile-nav"
    class="md:hidden hidden flex-col gap-1 px-4 pb-4 bg-zinc-950 border-t border-zinc-800 text-sm font-medium"
  >
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class={`block px-3 py-2.5 rounded-lg transition-colors duration-200 cursor-pointer ${
          currentPath === href
            ? 'bg-amber-500 text-zinc-900'
            : 'text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800'
        }`}
      >
        {label}
      </a>
    ))}
    <a
      href="/kontakt"
      class="btn-gold mt-1 block text-center px-4 py-3 rounded-lg font-semibold cursor-pointer"
    >
      Jetzt anfragen
    </a>
  </nav>
</header>

<script>
  const btn = document.getElementById('burger-btn');
  const nav = document.getElementById('mobile-nav');

  btn?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
  });
</script>
