---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Mascot from '../components/Mascot';
import CookieBanner from '../components/CookieBanner.astro';
import { FIRMA } from '../data/firma';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = `Mobiler Autoaufbereitungs-Service in ${FIRMA.ort} und Umgebung. Professionelle PKW-, LKW- und Traktor-Innenreinigung direkt bei Ihnen vor Ort.`,
  ogImage = '/images/before-1.jpg',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: FIRMA.name,
  description: `Mobiler Autoaufbereitungs-Service in ${FIRMA.ort}`,
  telephone: FIRMA.telefon,
  email: FIRMA.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: FIRMA.ort,
    postalCode: FIRMA.plz,
    addressCountry: 'DE',
  },
  areaServed: FIRMA.einzugsgebiet,
  priceRange: '€€',
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} | {FIRMA.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.toString()} />

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} | ${FIRMA.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="de_DE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ${FIRMA.name}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Fonts preconnect (performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-zinc-950 text-zinc-100 flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />

    <!-- Mascot character -->
    <Mascot client:load />

    <!-- Cookie-Banner -->
    <CookieBanner />

    <!-- WhatsApp Floating Button -->
    <a
      href={`https://wa.me/${FIRMA.telefon.replace(/[\s\-\(\)]/g, '').replace(/^\+/, '').replace(/^00/, '')}`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="WhatsApp-Chat öffnen"
      class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 hover:bg-green-400 transition-colors duration-200 rounded-full shadow-lg flex items-center justify-center cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-7 h-7 fill-white" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
      </svg>
    </a>
  </body>

  <script>
    // Scroll entrance animations via Intersection Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    document.querySelectorAll('.fade-in-up').forEach((el) => observer.observe(el));

    // Hero-Parallax (dezent) — aus bei reduced-motion, Touch oder kleinem Viewport
    const parallaxLayers = Array.from(
      document.querySelectorAll<HTMLElement>('[data-parallax]')
    );
    const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)');
    const isSmall = window.matchMedia('(max-width: 768px)');

    let ticking = false;
    function updateParallax() {
      const y = window.scrollY;
      for (const el of parallaxLayers) {
        const speed = parseFloat(el.dataset.parallax || '0');
        el.style.transform = `translate3d(0, ${y * speed}px, 0)`;
      }
      ticking = false;
    }
    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }

    if (
      parallaxLayers.length > 0 &&
      !noMotion.matches &&
      !isTouch.matches &&
      !isSmall.matches
    ) {
      updateParallax();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  </script>
</html>
